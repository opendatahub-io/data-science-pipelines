FROM golang:1.26.3-bookworm@sha256:47ce5636e9936b2c5cbf708925578ef386b4f8872aec74a67bd13a627d242b19 AS builder

# Update package repo and install required libraries
RUN apt-get update && apt-get install -y cmake clang musl-dev openssl util-linux

ENV KUBECONFIG=/dspa/backend/test/.kube/config

# Declare working directory
WORKDIR /dspa

# Download the latest OpenShift CLI binary
RUN wget -q https://mirror.openshift.com/pub/openshift-v4/clients/ocp/stable-4.20/openshift-client-linux.tar.gz -P oc-client && \
    tar -xf oc-client/openshift-client-linux.tar.gz -C oc-client && \
    cp oc-client/oc oc-client/kubectl /usr/local/bin && \
    rm -rf oc-client/

# Download latest Kustomize library
RUN wget -q https://github.com/kubernetes-sigs/kustomize/releases/download/kustomize/v5.8.0/kustomize_v5.8.0_linux_amd64.tar.gz -P kustomize && \
    tar -xf kustomize/kustomize_v5.8.0_linux_amd64.tar.gz -C kustomize && \
    cp kustomize/kustomize /usr/local/bin/kustomize && \
    rm -rf kustomize

# Copy all required go files from the project
COPY ./go.mod ./
COPY ./go.sum ./
COPY ./kubernetes_platform/go.mod ./kubernetes_platform/go.mod
COPY ./api/go.mod ./api/go.mod

# Download all go modules
RUN GO111MODULE=on go mod download

# Copy project files
COPY ./backend ./backend
COPY ./api ./api
COPY ./kubernetes_platform ./kubernetes_platform
COPY ./test_data ./test_data
COPY ./.github/resources/scripts/collect-logs.sh ./.github/resources/scripts/collect-logs.sh

# Allow non-root UIDs (e.g. CI runners using --user 1001:1001) to compile the
# Ginkgo test suites, which write the compiled *.test binaries in place, and
# to reuse the preloaded Go module cache.
RUN chmod -R a+rwX /dspa/backend/test /go

# Keep the Go build cache at a HOME-independent, world-writable location for
# non-root UIDs (HOME is not writable when an arbitrary --user is passed).
ENV GOCACHE=/tmp/go-build-cache

WORKDIR /dspa/backend/test/images

# Command to run the tests
ENTRYPOINT ["bash", "test-run.sh"]
